<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:core="clr-namespace:Pegged.Core">

    <core:TagToCornerRadiusConverter x:Key="TagToCornerRadius" />

    <!-- ==================================================================
         Pegged · Fluent Design 2.0 tokens
         This dictionary holds the light values and every control style.
         Themes/FluentTheme.Dark.xaml overrides the brushes only, so a theme
         switch is a dictionary swap with no code branching.
         ================================================================== -->

    <!-- Light palette -->
    <Color x:Key="Palette.Acrylic">#C8F4F6FB</Color>
    <Color x:Key="Palette.Card">#E0FEFEFE</Color>
    <Color x:Key="Palette.Surface">#FFFFFFFF</Color>
    <Color x:Key="Palette.SurfaceAlt">#FFF7F8FC</Color>
    <Color x:Key="Palette.Border">#FFE3E6EE</Color>
    <Color x:Key="Palette.Text">#FF1A1B1F</Color>
    <Color x:Key="Palette.TextSecondary">#FF5C5F66</Color>
    <Color x:Key="Palette.SubtleText">#FF6F737B</Color>
    <Color x:Key="Palette.Accent">#FF0F6CBD</Color>
    <Color x:Key="Palette.AccentAlt">#FF7B61FF</Color>
    <Color x:Key="Palette.Rope">#FF787E8A</Color>
    <Color x:Key="Palette.RopeHighlight">#73FFFFFF</Color>
    <Color x:Key="Palette.WoodLight">#FFEEC498</Color>
    <Color x:Key="Palette.WoodMid">#FFD69E64</Color>
    <Color x:Key="Palette.WoodDark">#FF966034</Color>
    <Color x:Key="Palette.BandLight">#FFE2E8F0</Color>
    <Color x:Key="Palette.BandDark">#FF949EAC</Color>
    <Color x:Key="Palette.Success">#FF0F7B0F</Color>
    <Color x:Key="Palette.Mask">#8C000000</Color>
    <Color x:Key="Palette.Shadow">#2E000000</Color>
    <Color x:Key="Palette.Window">#FFF6F7FB</Color>
    <Color x:Key="Palette.Sidebar">#FFEFF1F6</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Brush.Acrylic" Color="{DynamicResource Palette.Acrylic}" />
    <SolidColorBrush x:Key="Brush.Card" Color="{DynamicResource Palette.Card}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource Palette.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{DynamicResource Palette.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Palette.Border}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{DynamicResource Palette.Text}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource Palette.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.SubtleText" Color="{DynamicResource Palette.SubtleText}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Palette.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentAlt" Color="{DynamicResource Palette.AccentAlt}" />
    <SolidColorBrush x:Key="Brush.Rope" Color="{DynamicResource Palette.Rope}" />
    <SolidColorBrush x:Key="Brush.RopeHighlight" Color="{DynamicResource Palette.RopeHighlight}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Palette.Success}" />
    <SolidColorBrush x:Key="Brush.Mask" Color="{DynamicResource Palette.Mask}" />
    <SolidColorBrush x:Key="Brush.Window" Color="{DynamicResource Palette.Window}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{DynamicResource Palette.Sidebar}" />

    <!-- Gradients -->
    <LinearGradientBrush x:Key="Brush.Wood" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{DynamicResource Palette.WoodLight}" Offset="0" />
        <GradientStop Color="{DynamicResource Palette.WoodMid}" Offset="0.55" />
        <GradientStop Color="{DynamicResource Palette.WoodDark}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Band" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource Palette.BandLight}" Offset="0" />
        <GradientStop Color="{DynamicResource Palette.BandDark}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.CardEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D8FFFFFF" Offset="0" />
        <GradientStop Color="#2EFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.EdgePill" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#004CC2FF" Offset="0" />
        <GradientStop Color="{DynamicResource Palette.AccentAlt}" Offset="0.5" />
        <GradientStop Color="#007B61FF" Offset="1" />
    </LinearGradientBrush>

    <!-- Metrics -->
    <sys:Double x:Key="Radius.Card">16</sys:Double>
    <sys:Double x:Key="Radius.Photo">12</sys:Double>
    <sys:Double x:Key="Radius.Control">8</sys:Double>

    <!-- The same radii as CornerRadius, which is what a Border actually asks
         for. Fluent 2 is built on continuous corners, kept in one place. -->
    <CornerRadius x:Key="Corner.Card">16</CornerRadius>
    <CornerRadius x:Key="Corner.Photo">12</CornerRadius>
    <CornerRadius x:Key="Corner.Control">8</CornerRadius>
    <CornerRadius x:Key="Corner.Pill">999</CornerRadius>
    <sys:Double x:Key="Photo.Inset">4</sys:Double>
    <sys:Double x:Key="Photo.MaxHeight">104</sys:Double>
    <sys:Double x:Key="Card.Width">150</sys:Double>
    <sys:Double x:Key="Rope.Top">10</sys:Double>
    <sys:Double x:Key="Pin.Above">9.5</sys:Double>
    <sys:Double x:Key="Pin.Width">9</sys:Double>
    <sys:Double x:Key="Pin.Height">26</sys:Double>
    <sys:Double x:Key="EdgePill.Height">4</sys:Double>
    <sys:Double x:Key="EdgePill.Width">120</sys:Double>
    <sys:Double x:Key="Panel.Height">210</sys:Double>

    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>

    <DropShadowEffect x:Key="Effect.Card" Color="{DynamicResource Palette.Shadow}" Direction="270"
                      ShadowDepth="5" BlurRadius="10" Opacity="0.18" />
    <DropShadowEffect x:Key="Effect.CardHover" Color="{DynamicResource Palette.Shadow}" Direction="270"
                      ShadowDepth="8" BlurRadius="14" Opacity="0.26" />
    <DropShadowEffect x:Key="Effect.Pin" Color="#4D000000" Direction="270"
                      ShadowDepth="1.5" BlurRadius="2" Opacity="0.30" />
    <DropShadowEffect x:Key="Effect.Flyout" Color="#33000000" Direction="270"
                      ShadowDepth="4" BlurRadius="18" Opacity="0.22" />

    <!-- ====================== Controls ====================== -->

    <Style x:Key="GlassButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Acrylic}" />
        <Setter Property="BorderBrush" Value="#59FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="{TemplateBinding Tag, Converter={StaticResource TagToCornerRadius}}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RoundGlassButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Tag" Value="15" />
    </Style>

    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="18,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="15" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="40" Height="22">
                        <Border x:Name="Track" CornerRadius="11" Background="#FFC7CBD3" />
                        <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White"
                                 HorizontalAlignment="Left" Margin="2,0,0,0">
                            <Ellipse.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.25" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsRow" TargetType="Border">
        <Setter Property="Height" Value="56" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SubtleHint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.SubtleText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Rectangle x:Name="Indicator" Width="3" Height="18" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{DynamicResource Brush.Accent}" HorizontalAlignment="Left"
                                   Margin="0,0,0,0" Opacity="0" />
                        <Border x:Name="Root" CornerRadius="8" Margin="0,2" Background="Transparent" />
                        <ContentPresenter Margin="14,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface}" />
                            <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
