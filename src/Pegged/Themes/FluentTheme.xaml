<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:core="clr-namespace:Pegged.Core">

    <core:TagToCornerRadiusConverter x:Key="TagToCornerRadius" />

    <!-- ==================================================================
         Pegged · Fluent Design 2.0 tokens
         This dictionary holds the light values and every control style.
         Themes/FluentTheme.Dark.xaml is the dark half: it redefines the
         palette AND every brush, gradient and shadow that looks different,
         because a nested {DynamicResource Palette.X} inside a brush is
         resolved once and never again - a palette-only overlay is a no-op at
         runtime. A theme switch is a dictionary swap with no code branching.
         ================================================================== -->

    <!-- Light palette -->
    <!-- A small floating panel (the quick-action pill, the empty-state
         capsule, the crop bar). Not a material: no blur, no grain - just a
         nearly opaque fill, so it reads on any desktop without turning the
         strip into a slab. -->
    <Color x:Key="Palette.Flyout">#F2F4F8FC</Color>
    <Color x:Key="Palette.Card">#E0FEFEFE</Color>
    <Color x:Key="Palette.Surface">#FFFFFFFF</Color>
    <Color x:Key="Palette.SurfaceAlt">#FFF7F8FC</Color>
    <Color x:Key="Palette.Border">#FFE3E6EE</Color>
    <Color x:Key="Palette.Text">#FF1A1B1F</Color>
    <Color x:Key="Palette.TextSecondary">#FF5C5F66</Color>
    <Color x:Key="Palette.SubtleText">#FF6F737B</Color>
    <Color x:Key="Palette.Accent">#FF0F6CBD</Color>
    <Color x:Key="Palette.AccentAlt">#FF7B61FF</Color>
    <Color x:Key="Palette.Rope">#FF787E8A</Color>
    <Color x:Key="Palette.RopeHighlight">#73FFFFFF</Color>
    <Color x:Key="Palette.WoodLight">#FFEEC498</Color>
    <Color x:Key="Palette.WoodMid">#FFD69E64</Color>
    <Color x:Key="Palette.WoodDark">#FF966034</Color>
    <Color x:Key="Palette.BandLight">#FFE2E8F0</Color>
    <Color x:Key="Palette.BandDark">#FF949EAC</Color>
    <Color x:Key="Palette.Success">#FF0F7B0F</Color>
    <Color x:Key="Palette.OnSuccess">#FFFFFFFF</Color>
    <Color x:Key="Palette.Mask">#8C000000</Color>
    <Color x:Key="Palette.Shadow">#2E000000</Color>
    <Color x:Key="Palette.Window">#FFF6F7FB</Color>
    <Color x:Key="Palette.Sidebar">#FFEFF1F6</Color>
    <Color x:Key="Palette.OnAccent">#FFFFFFFF</Color>
    <Color x:Key="Palette.SwitchTrack">#FFC7CBD3</Color>
    <Color x:Key="Palette.SwitchKnob">#FFFFFFFF</Color>
    <Color x:Key="Palette.CardEdgeTop">#D8FFFFFF</Color>
    <Color x:Key="Palette.CardEdgeBottom">#2EFFFFFF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Brush.Flyout" Color="{DynamicResource Palette.Flyout}" />
    <SolidColorBrush x:Key="Brush.Card" Color="{DynamicResource Palette.Card}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource Palette.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{DynamicResource Palette.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Palette.Border}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{DynamicResource Palette.Text}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource Palette.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.SubtleText" Color="{DynamicResource Palette.SubtleText}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Palette.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentAlt" Color="{DynamicResource Palette.AccentAlt}" />
    <SolidColorBrush x:Key="Brush.Rope" Color="{DynamicResource Palette.Rope}" />
    <SolidColorBrush x:Key="Brush.RopeHighlight" Color="{DynamicResource Palette.RopeHighlight}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Palette.Success}" />
    <SolidColorBrush x:Key="Brush.OnSuccess" Color="{DynamicResource Palette.OnSuccess}" />
    <SolidColorBrush x:Key="Brush.Mask" Color="{DynamicResource Palette.Mask}" />
    <SolidColorBrush x:Key="Brush.Window" Color="{DynamicResource Palette.Window}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{DynamicResource Palette.Sidebar}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{DynamicResource Palette.OnAccent}" />
    <SolidColorBrush x:Key="Brush.SwitchTrack" Color="{DynamicResource Palette.SwitchTrack}" />
    <SolidColorBrush x:Key="Brush.SwitchKnob" Color="{DynamicResource Palette.SwitchKnob}" />

    <!-- Gradients -->
    <LinearGradientBrush x:Key="Brush.Wood" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{DynamicResource Palette.WoodLight}" Offset="0" />
        <GradientStop Color="{DynamicResource Palette.WoodMid}" Offset="0.55" />
        <GradientStop Color="{DynamicResource Palette.WoodDark}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Band" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource Palette.BandLight}" Offset="0" />
        <GradientStop Color="{DynamicResource Palette.BandDark}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.CardEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource Palette.CardEdgeTop}" Offset="0" />
        <GradientStop Color="{DynamicResource Palette.CardEdgeBottom}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.EdgePill" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#004CC2FF" Offset="0" />
        <GradientStop Color="{DynamicResource Palette.AccentAlt}" Offset="0.5" />
        <GradientStop Color="#007B61FF" Offset="1" />
    </LinearGradientBrush>

    <!-- Metrics -->
    <sys:Double x:Key="Radius.Card">16</sys:Double>
    <sys:Double x:Key="Radius.Photo">12</sys:Double>
    <sys:Double x:Key="Radius.Control">8</sys:Double>

    <!-- The same radii as CornerRadius, which is what a Border actually asks
         for. Fluent 2 is built on continuous corners, kept in one place. -->
    <CornerRadius x:Key="Corner.Card">16</CornerRadius>
    <CornerRadius x:Key="Corner.Photo">12</CornerRadius>
    <CornerRadius x:Key="Corner.Control">8</CornerRadius>
    <CornerRadius x:Key="Corner.Pill">999</CornerRadius>
    <sys:Double x:Key="Photo.Inset">4</sys:Double>
    <sys:Double x:Key="Photo.MaxHeight">104</sys:Double>
    <sys:Double x:Key="Card.Width">150</sys:Double>
    <sys:Double x:Key="Rope.Top">10</sys:Double>
    <sys:Double x:Key="Pin.Above">9.5</sys:Double>
    <sys:Double x:Key="Pin.Width">9</sys:Double>
    <sys:Double x:Key="Pin.Height">26</sys:Double>
    <sys:Double x:Key="EdgePill.Height">4</sys:Double>
    <sys:Double x:Key="EdgePill.Width">120</sys:Double>
    <sys:Double x:Key="Panel.Height">210</sys:Double>

    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>

    <DropShadowEffect x:Key="Effect.Card" Color="{DynamicResource Palette.Shadow}" Direction="270"
                      ShadowDepth="5" BlurRadius="10" Opacity="0.18" />
    <DropShadowEffect x:Key="Effect.CardHover" Color="{DynamicResource Palette.Shadow}" Direction="270"
                      ShadowDepth="8" BlurRadius="14" Opacity="0.26" />
    <DropShadowEffect x:Key="Effect.Pin" Color="#4D000000" Direction="270"
                      ShadowDepth="1.5" BlurRadius="2" Opacity="0.30" />
    <DropShadowEffect x:Key="Effect.Flyout" Color="#33000000" Direction="270"
                      ShadowDepth="4" BlurRadius="18" Opacity="0.22" />

    <!-- ====================== Controls ====================== -->

    <Style x:Key="SubtleButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Flyout}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="{TemplateBinding Tag, Converter={StaticResource TagToCornerRadius}}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RoundSubtleButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Tag" Value="15" />
    </Style>

    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="18,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="{DynamicResource Corner.Control}" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="40" Height="22" Background="Transparent">
                        <Border x:Name="Track" CornerRadius="11"
                                Background="{DynamicResource Brush.SwitchTrack}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                        <Ellipse x:Name="Knob" Width="18" Height="18"
                                 Fill="{DynamicResource Brush.SwitchKnob}"
                                 HorizontalAlignment="Left" Margin="2,0,0,0"
                                 Effect="{DynamicResource Effect.Pin}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Border x:Name="FocusRing" CornerRadius="13" Margin="-3"
                                BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Brush.OnAccent}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="18" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="Padding" Value="10,6,30,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource FluentComboBoxItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Root" CornerRadius="{DynamicResource Corner.Control}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Brush.TextSecondary}"
                                              StrokeThickness="1.5" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" Margin="0,0,10,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          IsHitTestVisible="False" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Corner.Control}" Padding="4"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border CornerRadius="{DynamicResource Corner.Control}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentSlider" TargetType="Slider">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Brush.SwitchTrack}" />
                        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                               IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                            <Track.Resources>
                                <Style TargetType="RepeatButton">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Track.Resources>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="18" Height="18">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{DynamicResource Brush.Accent}"
                                                     Stroke="{DynamicResource Brush.Surface}" StrokeThickness="3" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsRow" TargetType="Border">
        <Setter Property="Height" Value="56" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SubtleHint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.SubtleText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Root" CornerRadius="8" Margin="0,2" Background="Transparent" />
                        <Rectangle x:Name="Indicator" Width="3" Height="18" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{DynamicResource Brush.Accent}" HorizontalAlignment="Left"
                                   Margin="0,0,0,0" Opacity="0" />
                        <ContentPresenter Margin="14,0,8,0" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Card}" />
                            <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
