<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================================================================
         Pegged · dark half of the Fluent theme.

         A theme dictionary has to be COMPLETE, not a palette overlay. The
         obvious-looking version of this file - just the palette colors that
         differ, leaving the brushes to FluentTheme.xaml - does nothing at
         runtime, and that was measured rather than assumed: a brush whose
         Color is {DynamicResource Palette.Card} resolves that reference once,
         while its own dictionary is alone in the chain, and it is never
         re-evaluated when a second dictionary is merged on top afterwards.
         With a palette-only overlay the card frame was still #E0FEFEFE and the
         settings text still #FF1A1B1F sitting on a #20242B sidebar, which is
         unreadable rather than merely wrong.

         So every brush, gradient and shadow whose look differs between the two
         themes is redefined here, in full. What lives once, in
         FluentTheme.xaml: the control styles and the metrics - identical in
         both themes, and looked up per element, which does re-resolve.
         ================================================================== -->

    <!-- Dark palette -->
    <Color x:Key="Palette.Flyout">#F224272E</Color>
    <Color x:Key="Palette.Card">#DB2A2E36</Color>
    <Color x:Key="Palette.Surface">#FF20242B</Color>
    <Color x:Key="Palette.SurfaceAlt">#FF262B33</Color>
    <Color x:Key="Palette.Border">#FF333944</Color>
    <Color x:Key="Palette.Text">#FFFFFFFF</Color>
    <Color x:Key="Palette.TextSecondary">#FFC9CDD4</Color>
    <Color x:Key="Palette.SubtleText">#FFC9CDD4</Color>
    <Color x:Key="Palette.Accent">#FF4CC2FF</Color>
    <Color x:Key="Palette.AccentAlt">#FF9B7BFF</Color>
    <Color x:Key="Palette.Rope">#FFB9BEC9</Color>
    <Color x:Key="Palette.RopeHighlight">#2EFFFFFF</Color>
    <Color x:Key="Palette.WoodLight">#FFD8A876</Color>
    <Color x:Key="Palette.WoodMid">#FFB9854F</Color>
    <Color x:Key="Palette.WoodDark">#FF7A4F2C</Color>
    <Color x:Key="Palette.BandLight">#FFCBD2DC</Color>
    <Color x:Key="Palette.BandDark">#FF79808E</Color>
    <Color x:Key="Palette.Success">#FF6CCB5F</Color>
    <Color x:Key="Palette.OnSuccess">#FF1A1B1F</Color>
    <Color x:Key="Palette.Mask">#9E000000</Color>
    <Color x:Key="Palette.Shadow">#59000000</Color>
    <Color x:Key="Palette.Window">#FF16181D</Color>
    <Color x:Key="Palette.Sidebar">#FF20242B</Color>
    <Color x:Key="Palette.OnAccent">#FF1A1B1F</Color>
    <Color x:Key="Palette.SwitchTrack">#FF3A414D</Color>
    <Color x:Key="Palette.SwitchKnob">#FFF3F5F8</Color>
    <Color x:Key="Palette.CardEdgeTop">#29FFFFFF</Color>
    <Color x:Key="Palette.CardEdgeBottom">#0FFFFFFF</Color>

    <!-- Brushes. Same keys, same order as FluentTheme.xaml. -->
    <SolidColorBrush x:Key="Brush.Flyout" Color="{DynamicResource Palette.Flyout}" />
    <SolidColorBrush x:Key="Brush.Card" Color="{DynamicResource Palette.Card}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource Palette.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{DynamicResource Palette.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Palette.Border}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{DynamicResource Palette.Text}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource Palette.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.SubtleText" Color="{DynamicResource Palette.SubtleText}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Palette.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentAlt" Color="{DynamicResource Palette.AccentAlt}" />
    <SolidColorBrush x:Key="Brush.Rope" Color="{DynamicResource Palette.Rope}" />
    <SolidColorBrush x:Key="Brush.RopeHighlight" Color="{DynamicResource Palette.RopeHighlight}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Palette.Success}" />
    <SolidColorBrush x:Key="Brush.OnSuccess" Color="{DynamicResource Palette.OnSuccess}" />
    <SolidColorBrush x:Key="Brush.Mask" Color="{DynamicResource Palette.Mask}" />
    <SolidColorBrush x:Key="Brush.Window" Color="{DynamicResource Palette.Window}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{DynamicResource Palette.Sidebar}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{DynamicResource Palette.OnAccent}" />
    <SolidColorBrush x:Key="Brush.SwitchTrack" Color="{DynamicResource Palette.SwitchTrack}" />
    <SolidColorBrush x:Key="Brush.SwitchKnob" Color="{DynamicResource Palette.SwitchKnob}" />

    <!-- Gradients -->
    <LinearGradientBrush x:Key="Brush.Wood" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{DynamicResource Palette.WoodLight}" Offset="0" />
        <GradientStop Color="{DynamicResource Palette.WoodMid}" Offset="0.55" />
        <GradientStop Color="{DynamicResource Palette.WoodDark}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Band" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource Palette.BandLight}" Offset="0" />
        <GradientStop Color="{DynamicResource Palette.BandDark}" Offset="1" />
    </LinearGradientBrush>

    <!-- Stroke.Card in dark mode: white 16% -> 6%, not the light theme's
         85% -> 18% gradient. -->
    <LinearGradientBrush x:Key="Brush.CardEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource Palette.CardEdgeTop}" Offset="0" />
        <GradientStop Color="{DynamicResource Palette.CardEdgeBottom}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.EdgePill" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#004CC2FF" Offset="0" />
        <GradientStop Color="{DynamicResource Palette.AccentAlt}" Offset="0.5" />
        <GradientStop Color="#007B61FF" Offset="1" />
    </LinearGradientBrush>

    <!-- Shadows. Same geometry as the light ones; the dark theme's shadow is a
         heavier base colour at a matching opacity, so a card sitting on a dark
         desktop still reads as a card and not as a hole in it. -->
    <DropShadowEffect x:Key="Effect.Card" Color="{DynamicResource Palette.Shadow}" Direction="270"
                      ShadowDepth="5" BlurRadius="10" Opacity="0.34" />
    <DropShadowEffect x:Key="Effect.CardHover" Color="{DynamicResource Palette.Shadow}" Direction="270"
                      ShadowDepth="8" BlurRadius="14" Opacity="0.46" />
</ResourceDictionary>
