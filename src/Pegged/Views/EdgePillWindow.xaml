<Window x:Class="Pegged.Views.EdgePillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pegged edge"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsTabStop="False"
        Width="160" Height="12">
    <!-- The collapsed line: four pixels of breathing light along the top edge,
         so the line is always there without being in the way. -->
    <Grid x:Name="Root">
        <Border x:Name="Pill" Height="4" Width="120" VerticalAlignment="Top"
                CornerRadius="0,0,3,3" Background="{DynamicResource Brush.EdgePill}"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="Transparent" Offset="0" />
                    <GradientStop Color="White" Offset="0.2" />
                    <GradientStop Color="White" Offset="0.8" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </Border.OpacityMask>
        </Border>
    </Grid>
</Window>
