<Window x:Class="Pegged.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Pegged.Localization"
        xmlns:views="clr-namespace:Pegged.Views"
        Title="{loc:Str Settings.Title}"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Ui}"
        AutomationProperties.AutomationId="SettingsWindow"
        WindowStartupLocation="CenterOwner"
        Width="720" Height="560"
        MinWidth="560" MinHeight="420"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style TargetType="ComboBox" BasedOn="{StaticResource FluentComboBox}" />
        <Style TargetType="TextBox" BasedOn="{StaticResource FluentTextBox}" />
        <Style TargetType="Slider" BasedOn="{StaticResource FluentSlider}" />
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- 侧栏与内容独立布局，保留 720×560 窗口和 240px 导航。 -->
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Side nav -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}"
                BorderBrush="{DynamicResource Brush.CardEdge}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="20,18,20,10">
                    <TextBlock Text="Pegged" FontFamily="{DynamicResource Font.Ui}"
                               FontWeight="SemiBold" FontSize="18"
                               Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="A clothesline for your screenshots"
                               FontFamily="{DynamicResource Font.Ui}" FontSize="11"
                               Foreground="{DynamicResource Brush.SubtleText}"
                               TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>

                <ListBox x:Name="NavList" AutomationProperties.AutomationId="NavList" Grid.Row="1" Margin="8,8,8,8"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnNavChanged">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}" />
                    </ListBox.Resources>
                <ListBoxItem x:Name="NavGeneral" AutomationProperties.AutomationId="NavGeneral" Tag="general">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}" />
                        <StackPanel>
                            <TextBlock Text="{loc:Str Settings.General}" FontSize="13" />
                            <TextBlock Text="{loc:Str Settings.GeneralDesc}" FontSize="10" Foreground="{DynamicResource Brush.SubtleText}" />
                        </StackPanel>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="NavCapture" AutomationProperties.AutomationId="NavCapture" Tag="capture">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE722;" Style="{StaticResource NavIcon}" />
                        <StackPanel>
                            <TextBlock Text="{loc:Str Settings.Capture}" FontSize="13" />
                            <TextBlock Text="{loc:Str Settings.CaptureDesc}" FontSize="10" Foreground="{DynamicResource Brush.SubtleText}" />
                        </StackPanel>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="NavAppearance" AutomationProperties.AutomationId="NavAppearance" Tag="appearance">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE790;" Style="{StaticResource NavIcon}" />
                        <StackPanel>
                            <TextBlock Text="{loc:Str Settings.Appearance}" FontSize="13" />
                            <TextBlock Text="{loc:Str Settings.AppearanceDesc}" FontSize="10" Foreground="{DynamicResource Brush.SubtleText}" />
                        </StackPanel>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="NavShortcuts" AutomationProperties.AutomationId="NavShortcuts" Tag="shortcuts">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE765;" Style="{StaticResource NavIcon}" />
                        <StackPanel>
                            <TextBlock Text="{loc:Str Settings.Shortcuts}" FontSize="13" />
                            <TextBlock Text="{loc:Str Settings.ShortcutsDesc}" FontSize="10" Foreground="{DynamicResource Brush.SubtleText}" />
                        </StackPanel>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="NavAbout" AutomationProperties.AutomationId="NavAbout" Tag="about">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" Style="{StaticResource NavIcon}" />
                        <StackPanel>
                            <TextBlock Text="{loc:Str Settings.About}" FontSize="13" />
                            <TextBlock Text="{loc:Str Settings.AboutDesc}" FontSize="10" Foreground="{DynamicResource Brush.SubtleText}" />
                        </StackPanel>
                    </StackPanel>
                </ListBoxItem>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="20,0,20,16" Orientation="Horizontal">
                    <Button x:Name="CloseButton" AutomationProperties.AutomationId="CloseButton" Style="{StaticResource SubtleButton}" Padding="12,6"
                            Click="OnClose" Content="{loc:Str Preview.Close}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,16,28,28">
            <Grid>
                <!-- General -->
                <StackPanel x:Name="GeneralPane" Visibility="Visible">
                    <TextBlock Text="{loc:Str Settings.General}" FontFamily="{DynamicResource Font.Ui}"
                               FontWeight="SemiBold" FontSize="28"
                               Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,4" />
                    <TextBlock Text="{loc:Str Settings.GeneralDesc}" FontFamily="{DynamicResource Font.Ui}"
                               FontSize="11" Foreground="{DynamicResource Brush.SubtleText}"
                               TextWrapping="Wrap" Margin="0,0,0,18" />

                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{loc:Str Settings.Language}" />
                                <TextBlock Text="{loc:Str Settings.LanguageDesc}" Style="{StaticResource SubtleHint}" />
                            </StackPanel>
                            <!-- Showcase 5: language is a segmented row, not a
                                 dropdown. Ten languages do not fit in pills, so
                                 the first three stay and the rest live under
                                 the trailing "…" pill. -->
                            <views:Segmented x:Name="LangSegmented" AutomationProperties.AutomationId="LangSegmented"
                                             Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                             />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{loc:Str Settings.Sounds}" />
                                <TextBlock Text="{loc:Str Settings.SoundsDesc}" Style="{StaticResource SubtleHint}" />
                            </StackPanel>
                            <views:ToggleSwitch x:Name="SoundsSwitch" AutomationProperties.AutomationId="SoundsSwitch" AutomationProperties.Name="{loc:Str Settings.Sounds}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Changed="OnSounds" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{loc:Str Settings.Keep}" />
                                <TextBlock Text="{loc:Str Settings.KeepDesc}" Style="{StaticResource SubtleHint}" />
                            </StackPanel>
                            <!-- Showcase 5: 随屏宽 / 25 / 50 / 100, as on the
                                 original. The vignettes used to offer
                                 8/12/16/20/32, which the original never had. -->
                            <views:Segmented x:Name="KeepSegmented" AutomationProperties.AutomationId="KeepSegmented"
                                             Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                             />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{loc:Str Settings.Size}" />
                                <TextBlock Text="{loc:Str Settings.SizeDesc}" Style="{StaticResource SubtleHint}" />
                            </StackPanel>
                            <views:Segmented x:Name="SizeSegmented" AutomationProperties.AutomationId="SizeSegmented"
                                             Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                             />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Capture -->
                <StackPanel x:Name="CapturePane" Visibility="Collapsed">
                    <TextBlock Text="{loc:Str Settings.Capture}" FontFamily="{DynamicResource Font.Ui}"
                               FontWeight="SemiBold" FontSize="28"
                               Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,4" />
                    <TextBlock Text="{loc:Str Settings.CaptureDesc}" FontFamily="{DynamicResource Font.Ui}"
                               FontSize="11" Foreground="{DynamicResource Brush.SubtleText}"
                               TextWrapping="Wrap" Margin="0,0,0,18" />

                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{loc:Str Settings.Folder}" />
                                <TextBlock x:Name="FolderPath" Style="{StaticResource SubtleHint}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button x:Name="ChangeFolderButton" AutomationProperties.AutomationId="ChangeFolderButton"
                                    Style="{StaticResource AccentButton}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="OnChangeFolder" Content="{loc:Str Settings.FolderChange}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{loc:Str Settings.Clipboard}" />
                                <TextBlock Text="{loc:Str Settings.ClipboardDesc}" Style="{StaticResource SubtleHint}" />
                            </StackPanel>
                            <views:ToggleSwitch x:Name="ClipboardSwitch" AutomationProperties.AutomationId="ClipboardSwitch" AutomationProperties.Name="{loc:Str Settings.Clipboard}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Changed="OnClipboard" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{loc:Str Settings.OverFullScreen}" />
                                <TextBlock Text="{loc:Str Settings.OverFullScreenDesc}" Style="{StaticResource SubtleHint}" />
                            </StackPanel>
                            <views:ToggleSwitch x:Name="FullScreenSwitch" AutomationProperties.AutomationId="FullScreenSwitch" AutomationProperties.Name="{loc:Str Settings.OverFullScreen}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Changed="OnFullScreen" />
                        </Grid>
                    </Border>

                    <!-- Up to three extra folders, watched exactly like the
                         main screenshot folder. -->
                    <Border Style="{StaticResource SettingsRow}" Height="Auto" Padding="10,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{loc:Str Settings.ExtraFolders}" />
                                <TextBlock Text="{loc:Str Settings.ExtraFoldersDesc}" Style="{StaticResource SubtleHint}" />
                                <TextBlock x:Name="ExtraFoldersText" Style="{StaticResource SubtleHint}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SubtleButton}" Padding="10,5" Margin="0,0,6,0"
                                        AutomationProperties.AutomationId="AddExtraFolder"
                                        Click="OnAddExtraFolder" Content="{loc:Str Settings.FolderAdd}" />
                                <Button Style="{StaticResource SubtleButton}" Padding="10,5"
                                        AutomationProperties.AutomationId="ClearExtraFolders"
                                        Click="OnClearExtraFolders" Content="{loc:Str Settings.FolderClear}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Inbox mode: Windows' own screenshot folder is pointed at
                         Pegged's store while the mode is on, and put back when
                         it is switched off or the app quits. -->
                    <Border Style="{StaticResource SettingsRow}" Height="Auto" Padding="10,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{loc:Str Settings.Inbox}" />
                                <TextBlock Text="{loc:Str Settings.InboxDesc}" Style="{StaticResource SubtleHint}" />
                                <TextBlock x:Name="InboxText" Style="{StaticResource SubtleHint}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SubtleButton}" Padding="10,5" Margin="0,0,6,0"
                                        AutomationProperties.AutomationId="RestoreInbox"
                                        Click="OnRestoreInbox" Content="{loc:Str Settings.InboxRestore}" />
                                <views:ToggleSwitch x:Name="InboxSwitch"
                                                    AutomationProperties.AutomationId="InboxSwitch"
                                                    AutomationProperties.Name="{loc:Str Settings.Inbox}"
                                                    VerticalAlignment="Center" Changed="OnInbox" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="AppearancePane" Visibility="Collapsed">
                    <TextBlock Text="{loc:Str Settings.Appearance}" FontFamily="{DynamicResource Font.Ui}"
                               FontWeight="SemiBold" FontSize="28"
                               Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,4" />
                    <TextBlock Text="{loc:Str Settings.AppearanceDesc}" FontFamily="{DynamicResource Font.Ui}"
                               FontSize="11" Foreground="{DynamicResource Brush.SubtleText}"
                               TextWrapping="Wrap" Margin="0,0,0,18" />

                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{loc:Str Settings.Theme}" />
                                <TextBlock Text="{Binding SelectedItem.Label, ElementName=ThemeCombo}" Style="{StaticResource SubtleHint}" x:Name="ThemeHint" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeCombo" AutomationProperties.AutomationId="ThemeCombo" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="160" SelectionChanged="OnTheme" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{loc:Str Settings.RevealDelay}" />
                                <TextBlock Text="{loc:Str Settings.RevealDelayDesc}" Style="{StaticResource SubtleHint}" />
                            </StackPanel>
                            <Slider x:Name="RevealSlider" AutomationProperties.AutomationId="RevealSlider" Width="180" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Minimum="0.05" Maximum="3" TickFrequency="0.05"
                                    ValueChanged="OnRevealDelay" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{loc:Str Settings.TopEdge}" />
                                <TextBlock Text="{loc:Str Settings.TopEdgeDesc}" Style="{StaticResource SubtleHint}" />
                            </StackPanel>
                            <views:ToggleSwitch x:Name="TopEdgeSwitch" AutomationProperties.AutomationId="TopEdgeSwitch" AutomationProperties.Name="{loc:Str Settings.TopEdge}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Changed="OnTopEdge" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{loc:Str Settings.Peek}" />
                                <TextBlock Text="{loc:Str Settings.PeekDesc}" Style="{StaticResource SubtleHint}" />
                            </StackPanel>
                            <views:ToggleSwitch x:Name="PeekSwitch" AutomationProperties.AutomationId="PeekSwitch" AutomationProperties.Name="{loc:Str Settings.Peek}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Changed="OnPeek" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Shortcuts -->
                <StackPanel x:Name="ShortcutsPane" Visibility="Collapsed">
                    <TextBlock Text="{loc:Str Settings.Shortcuts}" FontFamily="{DynamicResource Font.Ui}"
                               FontWeight="SemiBold" FontSize="28"
                               Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,4" />
                    <TextBlock Text="{loc:Str Settings.ShortcutsDesc}" FontFamily="{DynamicResource Font.Ui}"
                               FontSize="11" Foreground="{DynamicResource Brush.SubtleText}"
                               TextWrapping="Wrap" Margin="0,0,0,18" />

                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{loc:Str Settings.ShortcutToggle}" />
                                <TextBlock Text="{loc:Str Settings.RecordHint}" Style="{StaticResource SubtleHint}" />
                            </StackPanel>
                            <TextBox x:Name="HotkeyBox" AutomationProperties.AutomationId="HotkeyBox" IsReadOnly="True" Width="200" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                     HorizontalContentAlignment="Center"
                                     PreviewKeyDown="OnHotkeyDown" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{loc:Str Tray.OpenAtLogin}" />
                                <TextBlock Text="{loc:Str Settings.RecordHint}" Style="{StaticResource SubtleHint}" />
                            </StackPanel>
                            <views:ToggleSwitch x:Name="LoginSwitch" AutomationProperties.AutomationId="LoginSwitch" AutomationProperties.Name="{loc:Str Tray.OpenAtLogin}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Changed="OnLogin" />
                        </Grid>
                    </Border>

                    <!-- Brand + licence: the About page used to be text only. -->
                    <Border Style="{StaticResource SettingsRow}" Height="Auto" Padding="10,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Source="/assets/logo.png" Width="48" Height="48"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Pegged 1.0.0" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource SubtleHint}" TextWrapping="Wrap"
                                           Text="{loc:Str Settings.License}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- About -->
                <StackPanel x:Name="AboutPane" Visibility="Collapsed">
                    <TextBlock Text="{loc:Str Settings.About}" FontFamily="{DynamicResource Font.Ui}"
                               FontWeight="SemiBold" FontSize="28"
                               Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,4" />
                    <TextBlock Text="{loc:Str Settings.AboutDesc}" FontFamily="{DynamicResource Font.Ui}"
                               FontSize="11" Foreground="{DynamicResource Brush.SubtleText}"
                               TextWrapping="Wrap" Margin="0,0,0,18" />

                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{loc:Str Settings.Version}" />
                                <TextBlock Text="Pegged 1.0.0" Style="{StaticResource SubtleHint}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{loc:Str Settings.Website}" />
                                <TextBlock Text="github.com/dk900912/Pegged" Style="{StaticResource SubtleHint}" />
                            </StackPanel>
                            <Button x:Name="WebsiteButton" AutomationProperties.AutomationId="WebsiteButton"
                                    Style="{StaticResource AccentButton}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="OnWebsite" Content="{loc:Str Preview.Open}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{loc:Str Settings.Credits}" />
                                <TextBlock Text="A native Windows 11 port of tendedero (MIT) by alejandrobujan."
                                           Style="{StaticResource SubtleHint}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
