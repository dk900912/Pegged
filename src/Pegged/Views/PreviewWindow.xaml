<Window x:Class="Pegged.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Pegged.Localization"
        Title="{loc:Str Preview.Title}"
        Background="#99000000"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        MinWidth="380" MinHeight="320"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- A borderless preview: a glass frame, a title bar, the picture, and a
         small "Open" button to launch the real viewer. Esc / click on the
         glass to close. -->
    <Border CornerRadius="14" Background="{DynamicResource Brush.Window}"
            BorderBrush="{DynamicResource Brush.CardEdge}" BorderThickness="1"
            Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar: drag to move the whole window. -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDrag">
                <TextBlock x:Name="TitleText" Margin="20,0" VerticalAlignment="Center"
                           FontFamily="{DynamicResource Font.Ui}" FontSize="13"
                           Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0" Width="32" Height="28" Padding="0"
                        Style="{StaticResource RoundSubtleButton}" Tag="9"
                        Content="&#x2715;" Click="OnClose" />
            </Grid>

            <!-- The picture. Uniform scaling keeps the aspect ratio. -->
            <Image x:Name="BigImage" Grid.Row="1" Margin="20,0,20,12"
                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
                <Button Style="{StaticResource SubtleButton}" Padding="14,7" Margin="0,0,8,0"
                        Click="OnOpen" Content="{loc:Str Preview.Open}" />
                <Button Style="{StaticResource AccentButton}" Padding="14,7" Margin="0,0,8,0"
                        Click="OnCrop" Content="{loc:Str Preview.Crop}" />
                <Button Style="{StaticResource AccentButton}" Padding="14,7"
                        Click="OnClose" Content="{loc:Str Preview.Close}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
