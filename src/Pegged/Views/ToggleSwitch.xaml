<UserControl x:Class="Pegged.Views.ToggleSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="SwitchControl"
             Focusable="False"
             SnapsToDevicePixels="True">
    <CheckBox Style="{StaticResource FluentToggleSwitch}"
              IsChecked="{Binding IsOn, ElementName=SwitchControl, Mode=TwoWay}"
              AutomationProperties.AutomationId="{Binding Path=(AutomationProperties.AutomationId), ElementName=SwitchControl}"
              AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), ElementName=SwitchControl}" />
</UserControl>
