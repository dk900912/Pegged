<UserControl x:Class="Pegged.Views.ToggleSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             SnapsToDevicePixels="True">
    <!-- A switch that you click to flip. Knob slides, the track fills. -->
    <Grid x:Name="Root" Width="40" Height="20" Background="Transparent"
          Cursor="Hand" MouseLeftButtonDown="OnClick">
        <Rectangle x:Name="Track" Width="40" Height="20" RadiusX="10" RadiusY="10"
                   Fill="{DynamicResource Brush.SurfaceAlt}"
                   Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" />
        <Ellipse x:Name="Knob" Width="14" Height="14" HorizontalAlignment="Left" Margin="3,0,0,0"
                 Fill="White" Effect="{DynamicResource Effect.Pin}" />
    </Grid>
</UserControl>
