<Window x:Class="Pegged.Views.LineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Pegged.Localization"
        Title="Pegged"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsTabStop="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- The dock: a strip along the top of one screen. Its height is set from
         code, from the card size the user chose.

         Nothing paints the strip itself. What used to sit here was a filled
         panel - first a frosted material, then an opaque rectangle after the
         material was taken out - and both turned the line into a slab lying
         across the desktop, with the rope and the cards pasted on top. The
         showcase says the dock is three things: the rope, the photos and the
         quick-action bar (showcase 2). Everything else stays transparent. -->
    <Grid x:Name="Root">

        <!-- The rope, drawn edge to edge, sagging towards the middle -->
        <Canvas x:Name="RopeLayer" IsHitTestVisible="False">
            <Path x:Name="RopeShadow" Stroke="#38000000" StrokeThickness="2.4" />
            <Path x:Name="RopeCore" Stroke="{DynamicResource Brush.Rope}" StrokeThickness="1.6" />
            <Path x:Name="RopeHighlight" Stroke="{DynamicResource Brush.RopeHighlight}" StrokeThickness="0.8" />
        </Canvas>

        <!-- Cards hang here. Module 3 fills it. -->
        <Canvas x:Name="CardLayer" />

        <!-- Top quick actions: clear, pin, settings.
             The pill behind the buttons is decoration and is deliberately not
             hit testable: it floats over the top of the cards, and a pill that
             takes clicks would be a dead strip across every photo. -->
        <Grid x:Name="Toolbar" HorizontalAlignment="Center" VerticalAlignment="Top"
              Margin="0,10,0,0" Opacity="0">
            <Border Padding="6,4" CornerRadius="18"
                    Background="{DynamicResource Brush.Flyout}"
                    BorderBrush="#59FFFFFF" BorderThickness="1"
                    IsHitTestVisible="False"
                    Effect="{DynamicResource Effect.Flyout}" />
            <StackPanel Orientation="Horizontal" Margin="6,4">
                <Button x:Name="ClearButton" Style="{StaticResource RoundSubtleButton}"
                        Tag="15" ToolTip="{loc:Str Tray.ClearAll}" Click="OnClear" Content="&#x1F5D1;" />
                <Button x:Name="PinButton" Style="{StaticResource RoundSubtleButton}"
                        Tag="15" ToolTip="{loc:Str Tray.Pin}" Click="OnPin" Content="&#x1F4CC;" />
                <Button x:Name="SettingsButton" Style="{StaticResource RoundSubtleButton}"
                        Tag="15" ToolTip="{loc:Str Tray.Settings}" Click="OnSettings" Content="&#x2699;" />
            </StackPanel>
        </Grid>

        <!-- Empty state. It is centred, so while it is up it straddles the
             middle of the screen - exactly where the first card hangs. In WPF
             an element only stops taking clicks when it is Hidden, not when it
             is transparent: an invisible Border at Opacity 0 still owned the
             rectangle over the pictures, so every click aimed at the first
             card's photo was swallowed by the hint instead of copying.
             Visibility is driven from UpdateHint(); IsHitTestVisible stays
             false so no part of the pill can ever trap a click. -->
        <Border x:Name="Hint" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="14,7" CornerRadius="16" Background="{DynamicResource Brush.Flyout}"
                BorderBrush="#59FFFFFF" BorderThickness="1"
                Visibility="Hidden" IsHitTestVisible="False">
            <StackPanel>
                <TextBlock x:Name="HintText" Text="{loc:Str Line.Empty}"
                           FontFamily="{DynamicResource Font.Ui}" FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Center" />
                <TextBlock x:Name="HintSub" Text="{loc:Str Line.EmptyHint}"
                           FontFamily="{DynamicResource Font.Ui}" FontSize="11"
                           Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
