<Window x:Class="Pegged.Views.CropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Pegged.Localization"
        Title="{loc:Str Crop.Title}"
        Background="#E6000000"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <!-- The crop surface: everything is positioned relative to the displayed image. -->
        <Grid x:Name="Surface" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The image -->
            <Image x:Name="BigImage" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SizeChanged="OnImageSizeChanged" />

            <!-- 33% grid lines -->
            <Grid x:Name="GridLayer" IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" BorderBrush="#66FFFFFF" BorderThickness="0,0,1,1" />
                <Border Grid.Row="0" Grid.Column="1" BorderBrush="#66FFFFFF" BorderThickness="1,0,1,1" />
                <Border Grid.Row="0" Grid.Column="2" BorderBrush="#66FFFFFF" BorderThickness="1,0,0,1" />
                <Border Grid.Row="1" Grid.Column="0" BorderBrush="#66FFFFFF" BorderThickness="0,1,1,1" />
                <Border Grid.Row="1" Grid.Column="1" BorderBrush="#66FFFFFF" BorderThickness="1,1,1,1" />
                <Border Grid.Row="1" Grid.Column="2" BorderBrush="#66FFFFFF" BorderThickness="1,1,0,1" />
                <Border Grid.Row="2" Grid.Column="0" BorderBrush="#66FFFFFF" BorderThickness="0,1,1,0" />
                <Border Grid.Row="2" Grid.Column="1" BorderBrush="#66FFFFFF" BorderThickness="1,1,1,0" />
                <Border Grid.Row="2" Grid.Column="2" BorderBrush="#66FFFFFF" BorderThickness="1,1,0,0" />
            </Grid>

            <!-- Dim mask + selection + handles + label -->
            <Canvas x:Name="Overlay" IsHitTestVisible="False" />

            <!-- The draggable selection box -->
            <Rectangle x:Name="Selection" Stroke="White" StrokeThickness="2" Fill="#12FFFFFF"
                       Cursor="SizeAll" HorizontalAlignment="Left" VerticalAlignment="Top"
                       MouseLeftButtonDown="OnBoxDown" MouseMove="OnBoxMove" MouseLeftButtonUp="OnBoxUp" />
        </Grid>

        <!-- Size label floats above the box -->
        <TextBlock x:Name="SizeLabel" Foreground="White" FontSize="11"
                   Background="#CC000000" Padding="6,3" IsHitTestVisible="False"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- Floating glass action bar at bottom center -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40"
                Padding="10,6" CornerRadius="20"
                Background="{DynamicResource Brush.Acrylic}"
                BorderBrush="#59FFFFFF" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SizeHint" VerticalAlignment="Center" Margin="0,0,14,0"
                           FontFamily="{DynamicResource Font.Ui}" FontSize="11"
                           Foreground="{DynamicResource Brush.Text}" />
                <Button Style="{StaticResource GlassButton}" Padding="14,7" Margin="0,0,8,0"
                        Click="OnCancel" Content="{loc:Str Crop.Cancel}" />
                <Button Style="{StaticResource AccentButton}" Padding="14,7"
                        Click="OnApply" Content="{loc:Str Crop.Apply}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
