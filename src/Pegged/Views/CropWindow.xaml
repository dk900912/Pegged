<Window x:Class="Pegged.Views.CropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Pegged.Localization"
        Title="{loc:Str Crop.Title}"
        Background="#E6000000"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <!-- The crop surface: everything is positioned relative to the displayed image. -->
        <Grid x:Name="Surface" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="BigImage" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SizeChanged="OnImageSizeChanged" />

            <!-- Mask, selection, grid, handles and label all live on this canvas.
                 It MUST be hit-testable, or the eight drag handles never see
                 the mouse at all. -->
            <Canvas x:Name="Overlay" IsHitTestVisible="True" />
        </Grid>

        <!-- Floating glass action bar at bottom center -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40"
                Padding="10,6" CornerRadius="20"
                Background="{DynamicResource Brush.Flyout}"
                BorderBrush="#59FFFFFF" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SizeHint" VerticalAlignment="Center" Margin="0,0,14,0"
                           FontFamily="{DynamicResource Font.Ui}" FontSize="11"
                           Foreground="{DynamicResource Brush.Text}" />
                <Button Style="{StaticResource SubtleButton}" Padding="14,7" Margin="0,0,8,0"
                        AutomationProperties.AutomationId="CropCancel"
                        Click="OnCancel" Content="{loc:Str Crop.Cancel}" />
                <Button Style="{StaticResource AccentButton}" Padding="14,7"
                        AutomationProperties.AutomationId="CropApply"
                        Click="OnApply" Content="{loc:Str Crop.Apply}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
