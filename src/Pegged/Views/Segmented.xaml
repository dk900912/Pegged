<UserControl x:Class="Pegged.Views.Segmented"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Focusable="False"
            UseLayoutRounding="True"
            SnapsToDevicePixels="True">

    <!--
        Fluent segmented control (showcase 5 · 设置中心): a single pill that
        holds two to five mutually exclusive short options. Selected = raised
        card surface, unselected = transparent, as in the mock's .seg span.
    -->
    <UserControl.Resources>
        <Style x:Key="SegItem" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" CornerRadius="5" Padding="10,4"
                                Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource Brush.SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource Brush.Card}" />
                                <Setter TargetName="Root" Property="TextElement.Foreground"
                                        Value="{DynamicResource Brush.Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="7" Background="{DynamicResource Brush.SurfaceAlt}" Padding="2">
        <StackPanel x:Name="ItemsHost" Orientation="Horizontal" />
    </Border>
</UserControl>
