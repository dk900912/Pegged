<UserControl x:Class="Pegged.Views.CardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Pegged.Localization"
             Background="Transparent"
             Focusable="False"
             IsTabStop="False"
             SnapsToDevicePixels="True">

    <!-- One capture hanging from the line: a wooden peg gripping the rope at
         the top, the picture swinging below it. The whole thing rotates around
         the peg, which is where a real one pivots. -->
    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.16">
        <Grid.RenderTransform>
            <TransformGroup>
                <RotateTransform x:Name="Tilt" Angle="0" />
                <TranslateTransform x:Name="Slide" X="0" Y="0" />
                <ScaleTransform x:Name="Pop" ScaleX="1" ScaleY="1" />
                <ScaleTransform x:Name="Press" ScaleX="1" ScaleY="1" />
            </TransformGroup>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The peg (spec 3.3): a 9x26 wooden capsule split into two slats, a
             5x1.4 rope slot at the top and a 13x13 metal spring band clamping
             the middle. On hover the band slides down 2px and the slats part. -->
        <Grid x:Name="Pin" Grid.Row="0" Width="13" Height="30"
              HorizontalAlignment="Center" VerticalAlignment="Top"
              IsHitTestVisible="False">
            <Rectangle x:Name="PinSlatTop" Width="9" Height="12" RadiusX="3" RadiusY="3"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0"
                       Fill="{DynamicResource Brush.Wood}" Effect="{DynamicResource Effect.Pin}" />
            <Rectangle x:Name="PinSlatBottom" Width="9" Height="12" RadiusX="3" RadiusY="3"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                       Fill="{DynamicResource Brush.Wood}" Effect="{DynamicResource Effect.Pin}" />
            <!-- Rope slot: 5 x 1.4, a dark capsule sunk into the top slat -->
            <Rectangle Width="5" Height="1.4" RadiusX="0.7" RadiusY="0.7"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3.2,0,0"
                       Fill="#8C3A2312" />
            <!-- Spring band: 13 x 13, metal gradient, wider than the wood -->
            <Rectangle x:Name="PinBand" Width="13" Height="13" RadiusX="4.5" RadiusY="4.5"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                       Fill="{DynamicResource Brush.Band}" Effect="{DynamicResource Effect.Pin}" />
        </Grid>

        <!-- The picture: a polaroid frame. 4px of white card all round, outer
             corner 16 and inner corner 12 so the two radii stay concentric. -->
        <Border x:Name="Photo" Grid.Row="1" Margin="0,-4,0,6" Padding="4"
                Background="{DynamicResource Brush.Card}"
                BorderBrush="{DynamicResource Brush.CardEdge}" BorderThickness="0.5"
                CornerRadius="{DynamicResource Corner.Card}"
                Effect="{DynamicResource Effect.Card}">
            <Grid x:Name="PhotoClip">
                <Image x:Name="ThumbImage" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- Recordings are marked: there is no frame to show for them -->
                <Border x:Name="VideoBadge" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="9,5" CornerRadius="12" Background="{DynamicResource Brush.Mask}"
                        Visibility="Collapsed">
                    <TextBlock Text="&#x25B6;" FontSize="13" Foreground="White" />
                </Border>

                <!-- The file name, only while the pointer is on the card.
                     Decoration: it fades with Opacity, and an element that is
                     merely transparent still takes clicks, so the strip would
                     quietly eat part of the picture at the bottom. -->
                <Border x:Name="NameBar" VerticalAlignment="Bottom" Padding="6,4"
                        Background="{DynamicResource Brush.Mask}" Opacity="0"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="NameText" FontFamily="{DynamicResource Font.Ui}" FontSize="10"
                               Foreground="White" TextTrimming="CharacterEllipsis" />
                </Border>

                <!-- Bottom hover action row: copy / crop / delete. The glass
                     behind the buttons is decoration; only the buttons take
                     clicks, so the pill itself is not hit testable. -->
                <Border x:Name="ActionRowBg" VerticalAlignment="Bottom" Margin="4,0,4,26"
                        CornerRadius="10" Background="#66000000" Padding="4,3"
                        Opacity="0" IsHitTestVisible="False">
                    <StackPanel x:Name="ActionRow" Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button x:Name="CopyButton" Style="{StaticResource RoundGlassButton}" Tag="14"
                                Width="28" Height="28" Padding="0" Margin="0,0,6,0"
                                ToolTip="{loc:Str Card.Copied}" Content="&#x2398;" Click="OnCopy" />
                        <Button x:Name="CropButton" Style="{StaticResource RoundGlassButton}" Tag="14"
                                Width="28" Height="28" Padding="0" Margin="0,0,6,0"
                                ToolTip="{loc:Str Crop.Title}" Content="&#x2702;" Click="OnCrop" />
                        <Button x:Name="DeleteButton" Style="{StaticResource RoundGlassButton}" Tag="14"
                                Width="28" Height="28" Padding="0"
                                ToolTip="{loc:Str Card.TakeDown}" Content="&#x1F5D1;" Click="OnTakeDown" />
                    </StackPanel>
                </Border>

                <!-- "Copied!" lands on the card for a moment -->
                <Border x:Name="CopiedTag" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,36" Padding="10,5" CornerRadius="12"
                        Background="{DynamicResource Brush.Success}"
                        Opacity="0" IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="CopiedScale" ScaleX="0.6" ScaleY="0.6" />
                    </Border.RenderTransform>
                    <TextBlock Text="{loc:Str Card.Copied}" FontFamily="{DynamicResource Font.Ui}"
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.OnSuccess}" />
                </Border>

                <!-- Take it down (top-right) -->
                <Button x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="20" Height="20" Margin="0,4,4,0" Padding="0"
                        Style="{StaticResource RoundGlassButton}" Tag="9"
                        ToolTip="{loc:Str Card.TakeDown}" Content="&#x2715;" Opacity="0"
                        Click="OnTakeDown" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
