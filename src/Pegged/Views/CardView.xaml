<UserControl x:Class="Pegged.Views.CardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Pegged.Localization"
             Background="Transparent"
             Focusable="False"
             IsTabStop="False"
             SnapsToDevicePixels="True">

    <!-- One capture hanging from the line: a wooden peg gripping the rope at
         the top, the picture swinging below it. The whole thing rotates around
         the peg, which is where a real one pivots. -->
    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.16">
        <Grid.RenderTransform>
            <TransformGroup>
                <RotateTransform x:Name="Tilt" Angle="0" />
                <TranslateTransform x:Name="Slide" X="0" Y="0" />
                <ScaleTransform x:Name="Pop" ScaleX="1" ScaleY="1" />
                <ScaleTransform x:Name="Press" ScaleX="1" ScaleY="1" />
            </TransformGroup>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The peg: two wooden slats and the little metal spring between them -->
        <Grid x:Name="Pin" Grid.Row="0" Width="16" HorizontalAlignment="Center"
              VerticalAlignment="Top" IsHitTestVisible="False">
            <!-- Top slat -->
            <Rectangle x:Name="PinSlatTop" Width="9" Height="16" RadiusX="3" RadiusY="3"
                       VerticalAlignment="Top" Margin="0,0,0,0"
                       Fill="{DynamicResource Brush.Wood}" Effect="{DynamicResource Effect.Pin}" />
            <!-- Metal spring band -->
            <Rectangle x:Name="PinBand" Width="7" Height="7" RadiusX="2" RadiusY="2"
                       VerticalAlignment="Top" Margin="0,11,0,0" Fill="{DynamicResource Brush.Band}" />
            <!-- Bottom slat -->
            <Rectangle x:Name="PinSlatBottom" Width="13" Height="8" RadiusX="2.2" RadiusY="2.2"
                       VerticalAlignment="Top" Margin="0,21,0,0" Fill="{DynamicResource Brush.Wood}" />
            <!-- Highlight slot -->
            <Rectangle Width="5" Height="2" RadiusX="1" RadiusY="1"
                       VerticalAlignment="Top" Margin="0,12.5,0,0" Fill="#59FFFFFF" />
        </Grid>

        <!-- The picture -->
        <Border x:Name="Photo" Grid.Row="1" Margin="0,-4,0,6"
                Background="{DynamicResource Brush.Card}"
                BorderBrush="{DynamicResource Brush.CardEdge}" BorderThickness="1"
                CornerRadius="{DynamicResource Corner.Photo}"
                Effect="{DynamicResource Effect.Card}">
            <Grid x:Name="PhotoClip">
                <Image x:Name="ThumbImage" Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- Recordings are marked: there is no frame to show for them -->
                <Border x:Name="VideoBadge" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="9,5" CornerRadius="12" Background="{DynamicResource Brush.Mask}"
                        Visibility="Collapsed">
                    <TextBlock Text="&#x25B6;" FontSize="13" Foreground="White" />
                </Border>

                <!-- The file name, only while the pointer is on the card -->
                <Border x:Name="NameBar" VerticalAlignment="Bottom" Padding="6,4"
                        Background="{DynamicResource Brush.Mask}" Opacity="0">
                    <TextBlock x:Name="NameText" FontFamily="{DynamicResource Font.Ui}" FontSize="10"
                               Foreground="White" TextTrimming="CharacterEllipsis" />
                </Border>

                <!-- Bottom hover action row: copy / crop / delete -->
                <Border x:Name="ActionRowBg" VerticalAlignment="Bottom" Margin="4,0,4,26"
                        CornerRadius="10" Background="#66000000" Padding="4,3"
                        Opacity="0">
                    <StackPanel x:Name="ActionRow" Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button x:Name="CopyButton" Style="{StaticResource RoundGlassButton}" Tag="14"
                                Width="28" Height="28" Padding="0" Margin="0,0,6,0"
                                ToolTip="{loc:Str Card.Copied}" Content="&#x2398;" Click="OnCopy" />
                        <Button x:Name="CropButton" Style="{StaticResource RoundGlassButton}" Tag="14"
                                Width="28" Height="28" Padding="0" Margin="0,0,6,0"
                                ToolTip="{loc:Str Crop.Title}" Content="&#x2702;" Click="OnCrop" />
                        <Button x:Name="DeleteButton" Style="{StaticResource RoundGlassButton}" Tag="14"
                                Width="28" Height="28" Padding="0"
                                ToolTip="{loc:Str Card.TakeDown}" Content="&#x1F5D1;" Click="OnTakeDown" />
                    </StackPanel>
                </Border>

                <!-- "Copied!" lands on the card for a moment -->
                <Border x:Name="CopiedTag" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,36" Padding="10,5" CornerRadius="12"
                        Background="{DynamicResource Brush.Success}"
                        Opacity="0" IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="CopiedScale" ScaleX="0.6" ScaleY="0.6" />
                    </Border.RenderTransform>
                    <TextBlock Text="{loc:Str Card.Copied}" FontFamily="{DynamicResource Font.Ui}"
                               FontSize="11" FontWeight="SemiBold" Foreground="White" />
                </Border>

                <!-- Take it down (top-right) -->
                <Button x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="20" Height="20" Margin="0,4,4,0" Padding="0"
                        Style="{StaticResource RoundGlassButton}" Tag="9"
                        ToolTip="{loc:Str Card.TakeDown}" Content="&#x2715;" Opacity="0"
                        Click="OnTakeDown" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
