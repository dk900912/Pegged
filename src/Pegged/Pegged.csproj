<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>Pegged</AssemblyName>
    <RootNamespace>Pegged</RootNamespace>
    <ApplicationIcon>$(MSBuildThisFileDirectory)..\..\assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Company>dk900912</Company>
    <Product>Pegged</Product>
    <Description>A clothesline for your screenshots. Pegged hangs captures on a line above your screen.</Description>
    <Copyright>Copyright (c) 2026 Pegged contributors. Ported from tendedero (MIT).</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows Forms is in scope for the tray icon, so System.Drawing and
         System.Windows both come in as implicit usings and collide.
         Pegged is a WPF app: the WPF spelling wins every short name. -->
    <Using Include="System.Windows.Point" Alias="Point" />
    <Using Include="System.Windows.Size" Alias="Size" />
    <Using Include="System.Windows.Rect" Alias="Rect" />
    <Using Include="System.Windows.Media.Color" Alias="Color" />
    <Using Include="System.Windows.Media.Brush" Alias="Brush" />
    <Using Include="System.Windows.Controls.Canvas" Alias="Canvas" />
    <Using Include="System.Windows.Controls.Image" Alias="Image" />
    <Using Include="System.Windows.Controls.Border" Alias="Border" />
    <Using Include="System.Windows.Controls.Control" Alias="Control" />
    <Using Include="System.Windows.Controls.UserControl" Alias="UserControl" />
    <Using Include="System.Windows.IDataObject" Alias="IDataObject" />
    <Using Include="System.Windows.Clipboard" Alias="Clipboard" />
    <Using Include="System.Windows.DataFormats" Alias="DataFormats" />
    <Using Include="System.Windows.DataObject" Alias="DataObject" />
    <Using Include="System.Windows.DragDrop" Alias="DragDrop" />
    <Using Include="System.Windows.DragDropEffects" Alias="DragDropEffects" />
    <Using Include="System.Windows.Input.KeyEventArgs" Alias="KeyEventArgs" />
    <Using Include="System.Windows.Input.MouseEventArgs" Alias="MouseEventArgs" />
    <Using Include="System.Windows.Input.MouseButtonEventArgs" Alias="MouseButtonEventArgs" />
    <Using Include="System.Windows.Media.Brushes" Alias="Brushes" />
    <Using Include="System.Windows.Input.Cursors" Alias="Cursors" />
    <Using Include="System.Windows.Shapes.Rectangle" Alias="Rectangle" />
    <Using Include="System.Windows.Application" Alias="Application" />
    <Using Include="System.Windows.Controls.Button" Alias="Button" />
    <Using Include="System.Windows.MessageBox" Alias="MessageBox" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\app.ico" Link="app.ico" />
    <None Include="..\..\assets\logo.png" Link="logo.png" />
    <Resource Include="..\..\assets\logo.png" Link="assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>

</Project>
